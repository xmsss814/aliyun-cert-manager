# ============================================================
#  阿里云 SSL 证书管理 — 配置示例
#  复制为 .env 后填入实际值
# ============================================================

# --- 阿里云凭证 (必填) ---
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# --- 证书配置 ---
# 证书主域名 (必填，例如 example.com 或 app.example.com)
CERT_DOMAIN=example.com

# 证书存放目录 (与 CERT_FILE/KEY_FILE 二选一)
CERT_DIR=./certs

# 显式指定证书文件路径 (可选，覆盖 CERT_DIR/cert.pem)
# CERT_FILE=/etc/nginx/certs/example.com.pem
# KEY_FILE=/etc/nginx/certs/example.com.key
# FULLCHAIN_FILE=/etc/nginx/certs/example.com.fullchain.pem
# 留空字符串 "" 可禁用 fullchain 输出
# FULLCHAIN_FILE=

# --- 证书类型 ---
# 预设别名: free-dv / dv / ov / ev
# 密钥为平台托管模式：由阿里云生成并保管，签发后连私钥一并返回
CERT_TYPE=free-dv
# 直接指定阿里云 product_code (可选，覆盖 CERT_TYPE)
# PRODUCT_CODE=digicert-free-1-free

# --- DNS 验证 ---
# 阿里云 DNS 托管域名，用于自动添加 _dnsauth 验证记录
# 默认同 CERT_DOMAIN
ALIBABA_DNS_DOMAIN=example.com

# --- 续期策略 ---
# 提前多少天触发续期
RENEWAL_DAYS=30
# 额外 SAN 域名，逗号分隔（仅用于日志展示；
# 平台托管模式下 SAN 由阿里云按主域名自动匹配，需自定义 SAN 请在控制台申请）
# CERT_SANS=api.example.com,cdn.example.com

# --- 部署 ---
# 不执行 reload 命令 (1=禁用, 0=启用 nginx -s reload)
# Docker Compose 默认禁用，证书通过 volume 共享给其他容器；如需重启其他服务：
#   1) 将本容器加入与目标服务相同的 Docker 网络
#   2) 通过 docker socket 或 docker compose 调用，详见 README
NO_RELOAD=1
# 自定义 reload 命令
# RELOAD_CMD=docker compose restart blog

# --- Docker Compose 守护进程 ---
# daemon 检查间隔（小时），默认 12
INTERVAL_HOURS=12
