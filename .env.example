# ============================================================
#  阿里云 SSL 证书管理 — 配置示例
#  复制为 .env 后填入实际值
# ============================================================

# --- 阿里云凭证 (必填) ---
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# --- 证书配置 ---
# 证书主域名 (必填，例如 example.com 或 app.example.com)
CERT_DOMAIN=example.com

# 证书存放目录 (与 CERT_FILE/KEY_FILE 二选一)
CERT_DIR=./certs

# 显式指定证书文件路径 (可选，覆盖 CERT_DIR/cert.pem)
# CERT_FILE=/etc/nginx/certs/example.com.pem
# KEY_FILE=/etc/nginx/certs/example.com.key
# FULLCHAIN_FILE=/etc/nginx/certs/example.com.fullchain.pem
# 想关闭 fullchain 输出时，把下面这行显式留空即可（FULLCHAIN_FILE= 后不要写任何字符）
# FULLCHAIN_FILE=

# --- 证书类型 ---
# 预设别名: free-dv / dv / ov / ev
# 密钥为平台托管模式：由阿里云生成并保管，签发后连私钥一并返回
CERT_TYPE=free-dv
# 直接指定阿里云 product_code (可选，覆盖 CERT_TYPE)
# PRODUCT_CODE=digicert-free-1-free

# --- DNS 验证 ---
# 阿里云 DNS 托管域名，用于自动添加 _dnsauth 验证记录
# 默认同 CERT_DOMAIN
ALIBABA_DNS_DOMAIN=example.com

# --- 续期策略 ---
# 提前多少天触发续期
RENEWAL_DAYS=30
# 关于 SAN：本工具**仅使用平台托管模式**（申请时不传 CSR），不支持自定义 SAN ——
# SAN 由阿里云按主域名自动匹配（免费 DV 通常含主域名 + www.）。
# 因此 CERT_SANS 已废弃，设置了也只会打印告警并被忽略；需要额外 SAN 请在阿里云控制台手动申请。

# --- 部署 ---
# 不执行 reload 命令 (1=禁用, 0=启用 nginx -s reload)
# Docker Compose 默认禁用，证书通过 volume 共享给其他容器；如需重启其他服务：
#   1) 将本容器加入与目标服务相同的 Docker 网络
#   2) 通过 docker socket 或 docker compose 调用，详见 README
NO_RELOAD=1
# 自定义 reload 命令
# RELOAD_CMD=docker compose restart blog

# --- Docker Compose 守护进程 ---
# daemon 检查间隔（小时），默认 12
INTERVAL_HOURS=12

# ============================================================
#  邮件通知（QQ 邮箱，可选）
# ============================================================
# 总开关：1=启用，0 或留空=关闭
NOTIFY_ENABLED=0

# SMTP 服务器：QQ 邮箱为 smtp.qq.com:465（SSL）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# 连接方式：ssl（465，默认）/ starttls（587）/ plain（不加密，仅本机调试用）
SMTP_SECURITY=ssl

# 发件邮箱，填完整 QQ 邮箱地址
SMTP_USER=
# SMTP 密码 —— 必须填 QQ 邮箱「授权码」，不是 QQ 登录密码！
# 获取方式：QQ 邮箱网页版 → 设置 → 账户 →
#          「POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务」→ 开启 SMTP 并生成授权码（16 位）
SMTP_PASSWORD=

# 收件人，多个用逗号分隔；留空则发给 SMTP_USER 自己
# NOTIFY_TO=you@qq.com,other@example.com
# 发件人地址，留空同 SMTP_USER
# NOTIFY_FROM=

# 设为 1 时"无需续期"也发通知（默认 0：只在真正续期成功或失败时发信）
NOTIFY_ON_NOOP=0
